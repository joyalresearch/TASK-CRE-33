  <tag k="description" v="Die Chaussee Altona-Kiel wurde von 1830 bis 1832 im Auftrage des dänischen Königs und Herzogs von Schleswig und Holstein Frederik VI gebaut. Mit ihr begann der moderne Chausseebau in Schleswig-Holstein, die Reisezeit verkürzte sich von 24 auf 10 Stunden."/>
  <tag k="historic" v="road"/>
  <tag k="name" v="Chaussee Altona-Kiel"/>
  <tag k="route" v="historic"/>
  <tag k="type" v="route"/>
  <tag k="website" v="https://www.altona-kiel.de/"/>
  <tag k="wikipedia" v="de:Altona-Kieler Chaussee"/>
  <tag k="year_of_construction" v="1830"/>
 </relation>
