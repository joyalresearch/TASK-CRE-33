  <tag k="communication:amateur_radio:pota" v="DE-0629"/>
  <tag k="description" v="Hamburg - Lübeck - Wismar - Rostock - Stralsund - Hanshagen (- Swinemünde / Stettin)"/>
  <tag k="length" v="570"/>
  <tag k="name" v="Hanseatenweg"/>
  <tag k="network" v="nwn"/>
  <tag k="note" v="Die Strecke Hamburg-Bremen wurde aufgegeben. Einige Schilder sind noch nicht demontiert. Quelle: 2012 Naturfreunde Nordheide. User:Smarties"/>
  <tag k="note_1" v="User Lübeck: 2011: Weg vom Baumwall bis Blankenese in HH wird neu erkundet;erstelle die Gesamtrelation jetzt in Zusammenarbeit mit dem Wegewart - bei Fragen bitte melden"/>
  <tag k="note_2" v="Juli 2011: Im Bereich Baumwall -&gt; Leinpfad derzeit noch keine Ausschilderung vorhanden;Verlauf nach Angaben des Wegewarts"/>
  <tag k="operator" v="Naturfreunde Deutschland e.V."/>
  <tag k="osmc:symbol" v="yellow:white:white_rectangle:H:black"/>
  <tag k="ref" v="Hanse"/>
  <tag k="route" v="hiking"/>
  <tag k="symbol" v="Weißes Schiff auf schwarzem Grund"/>
  <tag k="type" v="superroute"/>
