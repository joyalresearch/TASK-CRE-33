<!DOCTYPE html>

<head>
    <title>Sicherheitsprüfung</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta http-equiv="imagetoolbar" content="no">
    <meta name="author" content="BAUHAUS">
    <meta name="description" content="Fehlerseite von BAUHAUS">
    <meta name="keywords" content="bauhaus captcha 202 challenge">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport"
        content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />

    <style>/* ============================================
   CSS RESET & BASE STYLES
   ============================================ */

/* CSS Variables for consistent theming */
:root {
    --color-primary: #EE1F26;
    --color-secondary: #B41821;
    --color-success: #277921;
    --color-text: #666666;
    --color-text-light: #636363;
    --color-white: #FFFFFF;
    --color-background: #FFFFFF;

    --font-size-base: 1em;
    --font-size-large: 1.875em;
    --font-size-medium: 1.5em;
    --font-size-small: 1.25em;
    --font-size-extra-small: 14px;
    
    --spacing-small: 10px;
    --spacing-medium: 20px;
    --spacing-large: 45px;
    
    --border-radius: 4px;
    --transition-fast: 0.2s ease;
}

/* Normalize CSS Reset */
html {
    font-family: sans-serif;
    -ms-text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    font-size: 100%;
    height: 100%;
}

body {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--color-text);
    height: 100%;
    box-sizing: border-box;
    padding: 0;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

@font-face {
    font-family: 'bauhaus';
    src: url("data:font/woff;base64,") format("woff"), url("data:font/woff;base64,") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

h1 {
    color: var(--color-text);
    font-size: var(--font-size-large);
    margin-top: 0;
}

a {
    color: var(--color-text-light);
    text-decoration: none;
    background-color: transparent;
}

a:hover,
a:focus,
a:active {
    color: var(--color-text);
}

img {
    border: 0;
}

/* ============================================
   RESPONSIVE TYPOGRAPHY
   ============================================ */

@media screen and (min-width: 660px) and (max-width: 960px) {
    h1 {
        font-size: var(--font-size-medium);
    }
}

@media screen and (max-width: 659px) {
    h1 {
        font-size: var(--font-size-small);
    }
}

/* ============================================
   LAYOUT UTILITIES
   ============================================ */

.line {
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
}

.line::after {
    content: " ";
    display: block;
    clear: both;
}

.unit {
    float: left;
    display: block;
}

.clearfix::before,
.clearfix::after {
    content: "";
    display: table;
}

.clearfix::after {
    clear: both;
}

/* ============================================
   RESPONSIVE VIEWPORT UTILITIES
   ============================================ */

/* Small viewport (mobile) */
@media screen and (max-width: 659px) {
    .s-vp {
        display: block !important;
    }
    
    .m-vp,
    .l-vp {
        display: none !important;
    }
}

/* Medium viewport (tablet) */
@media screen and (min-width: 660px) and (max-width: 960px) {
    .m-vp {
        display: block !important;
    }
    
    .s-vp,
    .l-vp {
        display: none !important;
    }
}

/* Large viewport (desktop) */
@media screen and (min-width: 961px) {
    .l-vp {
        display: block !important;
    }
    
    .s-vp,
    .m-vp {
        display: none !important;
    }
}

/* ============================================
   HEADER COMPONENTS
   ============================================ */

.head {
    background-color: var(--color-primary);
    color: var(--color-white);
}

.modLogo a {
    display: inline-block;
}

.modLogo a img {
    display: none;
}

/* Logo responsive behavior */
@media screen and (max-width: 659px) {
    .modLogo a {
        margin-left: 0;
    }
    
    .modLogo a .s-vp {
        display: block;
        margin-top: 9px;
    }
}

@media screen and (min-width: 660px) and (max-width: 960px) {
    .modLogo a .m-vp {
        display: block;
        margin-top: -2px;
    }
}

@media screen and (min-width: 961px) {
    .modLogo a .l-vp {
        display: block;
        margin-top: -1px;
    }
}

/* ============================================
   ERROR PAGE LAYOUT
   ============================================ */

.error {
    text-align: center;
    min-height: 100%;
    margin-left: auto;
    margin-right: auto;
    background-color: var(--color-background);
}

.body {
    overflow: hidden;
}

.error .body {
    margin-top: 0;
    padding-top: var(--spacing-large);
}

.error p {
    margin-bottom: 0.25em;
}

.error .body p.email {
    margin-bottom: 1.5em;
}

.error .body p.phone,
.error .body p.email {
    font-size: 1.3em;
}

.error .body p.hint {
    text-align: center;
}

/* ============================================
   RESPONSIVE ERROR PAGE LAYOUT
   ============================================ */

/* Desktop layout */
@media (min-width: 961px) {
    .error {
        width: 80%;
    }

    .head .lineHeaderGradient {
        margin-bottom: 0;
        padding: 0.8em 0 0 13.2em;
        margin-top: -4px;
    }

    .sizeFixedHead {
        height: 2em;
    }

    .sizeFixedHeadBottom {
        height: 3em;
    }
}

/* Tablet layout */
@media (min-width: 660px) and (max-width: 960px) {
    .error {
        width: 100%;
    }

    .head .lineHeaderGradient {
        margin-bottom: 0;
    }

    .sizeFixedHead {
        height: 2em;
    }

    .sizeFixedHeadBottom {
        height: 1em;
    }
}

/* Mobile layout */
@media (max-width: 659px) {
    .error {
        width: 100%;
    }

    .head .lineHeaderGradient {
        margin-bottom: 0;
    }

    .sizeFixedHead {
        height: 0;
    }

    .sizeFixedHeadBottom {
        height: 0;
    }
}

/* ============================================
   UTILITY COMPONENTS
   ============================================ */

#info {
    margin-top: 3em;
    margin-bottom: 3.5em;
}

.social-description {
    margin-top: 4em;
}

.social-media {
    font-size: 1.7em;
    margin-top: 0.8em;
    padding-bottom: 1em;
}

.social-media a {
    padding: var(--spacing-small);
}

.icon-facebook:before {
    content: "\e808";
    font-family: 'bauhaus';
}

.icon-twitter:before {
    content: "\e809";
    font-family: 'bauhaus';
}

.icon-phone:before {
    content: "\e806";
    font-family: 'bauhaus';
}

/* ============================================
   CUSTOM COMPONENTS
   ============================================ */

/* Message container for error text */
.message-container {
    padding: var(--spacing-small);
    margin: var(--spacing-medium) auto;
    font-size: var(--font-size-extra-small);
    color: var(--color-text);
    text-align: left;
    width: fit-content;
}

/* Reload button styling */
.reload-button {
    display: inline-block;
    background-color: var(--color-success);
    color: var(--color-white);
    font-weight: bold;
    padding: 12px 24px;
    border: none;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: background-color var(--transition-fast);
    cursor: pointer;
}

.reload-button:hover,
.reload-button:focus {
    background-color: var(--color-secondary);
    color: var(--color-white);
    outline: none;
}</style>
    
